{
  "name": "huntforge",
  "version": "1.0.0",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"npm:ui\" \"npm:app\"",
    "ui": "vite",
    "app": "wait-on http://127.0.0.1:5173 && electron .",
    "start": "npm run dev"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "electron": "^37.2.6",
    "vite": "^7.1.3",
    "wait-on": "^8.0.4"
  },
  "allowScripts": {
    "electron@37.10.3": true,
    "esbuild@0.28.2": true
  }
}
