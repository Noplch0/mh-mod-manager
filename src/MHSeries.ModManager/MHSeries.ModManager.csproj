<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>MhModManager</RootNamespace>
    <AssemblyName>MhModManager</AssemblyName>
    <Product>mh-mod-manager</Product>
    <Version>1.0.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="SharpCompress" Version="0.39.0" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Data\Equipment\*.csv" />
    <EmbeddedResource Include="Data\Equipment\*.txt.gz" />
    <EmbeddedResource Include="Data\Equipment\*avp*.bin" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="MHSeries.ModManager.Tests" />
  </ItemGroup>
</Project>
