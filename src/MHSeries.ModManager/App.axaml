<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="HuntForge.App"
             RequestedThemeVariant="Dark">
  <Application.Styles>
    <FluentTheme />
    <Style Selector="Window">
      <Setter Property="Background" Value="#0A0D12" />
      <Setter Property="FontFamily" Value="Inter" />
    </Style>
    <Style Selector="TextBlock.h1">
      <Setter Property="FontSize" Value="28" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="#F4F6F8" />
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="#85909F" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="TextBlock.eyebrow">
      <Setter Property="Foreground" Value="#C9A35F" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.action">
      <Setter Property="Background" Value="#202832" />
      <Setter Property="BorderBrush" Value="#303B47" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="#DDE4EA" />
      <Setter Property="Padding" Value="13,9" />
      <Setter Property="CornerRadius" Value="7" />
    </Style>
    <Style Selector="Button.action:pointerover">
      <Setter Property="Background" Value="#2B3743" />
      <Setter Property="BorderBrush" Value="#C9A35F" />
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="#C9A35F" />
      <Setter Property="Foreground" Value="#15120C" />
      <Setter Property="BorderBrush" Value="#C9A35F" />
      <Setter Property="Padding" Value="15,9" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.primary:pointerover">
      <Setter Property="Background" Value="#E0B875" />
    </Style>
    <Style Selector="Button.icon">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Foreground" Value="#95A1AD" />
      <Setter Property="Padding" Value="8" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="Button.icon:pointerover">
      <Setter Property="Background" Value="#202832" />
      <Setter Property="Foreground" Value="#F4F6F8" />
    </Style>
    <Style Selector="ToggleSwitch">
      <Setter Property="OnContent" Value="" />
      <Setter Property="OffContent" Value="" />
    </Style>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="#121820" />
      <Setter Property="BorderBrush" Value="#26313C" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="9" />
    </Style>
    <Style Selector="Border.sidebarItem">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Margin" Value="0,2" />
    </Style>
    <Style Selector="Border.sidebarItem:pointerover">
      <Setter Property="Background" Value="#18212B" />
    </Style>
    <Style Selector="Border.sidebarItem.selected">
      <Setter Property="Background" Value="#252C32" />
      <Setter Property="BorderBrush" Value="#C9A35F" />
      <Setter Property="BorderThickness" Value="1,0,0,0" />
    </Style>
  </Application.Styles>
</Application>
